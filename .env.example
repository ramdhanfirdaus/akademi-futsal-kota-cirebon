# Connection string Postgres.
# Production (Neon): pakai connection string *pooled* (host mengandung "-pooler"), contoh:
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/afkc?sslmode=require
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/afkc_next

# Rahasia untuk menandatangani token login (minimal 32 karakter acak).
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Hanya dipakai saat menjalankan `npm run db:seed`.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ganti-password-admin
